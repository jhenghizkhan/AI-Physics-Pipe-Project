# %% [markdown]
# # AI Physics Pipe Project - Interactive Standing Waves
# This notebook simulates standing waves in **open and closed pipes**.
# Students can **type commands** to control the harmonic, pipe type, and pipe length.
# Voice input is disabled for Binder (browser-based).

# %%
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle
from matplotlib.animation import FuncAnimation

# %% [markdown]
# ## Function to calculate standing wave

# %%
def standing_wave(pipe_type='open', length=1.0, harmonic=1, v=343):
    """
    Returns position (x), wave number (k), and frequency (f) for a given pipe.
    """
    x = np.linspace(0, length, 1000)
    if pipe_type == 'open':
        wavelength = 2 * length / harmonic
    elif pipe_type == 'closed':
        wavelength = 4 * length / harmonic
    else:
        raise ValueError("pipe_type must be 'open' or 'closed'")
    frequency = v / wavelength
    k = 2 * np.pi / wavelength
    return x, k, frequency

# %% [markdown]
# ## User Input

# %%
# Typed input only for Binder
harmonic = int(input("Enter harmonic number (1,2,3...): "))
pipe_type = input("Enter pipe type (open/closed): ").lower()
length = float(input("Enter pipe length in meters: "))

# %% [markdown]
# ## Animation Setup

# %%
# Generate wave data
x, k, f = standing_wave(pipe_type, length, harmonic)
amplitude = 0.2

# Create figure
%matplotlib notebook
fig, ax = plt.subplots(figsize=(10,4))
ax.set_xlim(-0.1, length + 0.1)
ax.set_ylim(-0.5, 0.5)
ax.set_xlabel("Position along pipe (m)")
ax.set_ylabel("Amplitude")
ax.set_title(f"{pipe_type.capitalize()} Pipe - Harmonic {harmonic} - {length} m - f={f:.2f}Hz")
ax.grid(True)

# Draw pipe rectangle
rect = Rectangle((0, -amplitude), length, 2*amplitude, fill=False, edgecolor='blue', linewidth=2)
ax.add_patch(rect)

# Line for wave
line, = ax.plot([], [], 'b-', linewidth=2)

# %% [markdown]
# ## Animation Function

# %%
def animate(t):
    y = amplitude * np.sin(k*x) * np.cos(2*np.pi*f*t)
    line.set_data(x, y)
    return line,

anim = FuncAnimation(fig, animate, frames=np.linspace(0,0.02,200), interval=50, blit=True)
plt.show()
